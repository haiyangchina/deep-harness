{
  "name": "deep-harness-desktop",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "Local desktop workspace for deep-harness",
  "author": "deep-harness",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "nanostores": "1.4.2",
    "@nanostores/react": "1.1.0"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "27.0.0-alpha.6",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "local.deepharness.desktop",
    "productName": "deep-harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "deep-harness-${version}-${arch}.exe"
    }
  }
}
